# ChemApp local configuration
#
# Copy this file to .env and load it in your shell/process manager.  Never
# commit the real .env file or any API/admin secret.

# Runtime data (keep outside the source tree in production)
CHEMAPP_DB_PATH=backend/data/chemapp.db
CHEMAPP_NMR_INDEX=backend/data/nmr_spectral_index.sqlite
CHEMAPP_NMR_INDEX_V2=backend/data/nmr_spectral_index_v2.sqlite
CHEMAPP_NMR_RANKER=backend/data/nmr_joint_ranker.joblib
CHEMAPP_T5_MODEL_DIR=backend/app/ml/pretrained/t5_nmr
# CHEMAPP_NMR_DATA_DIR=D:/chemapp/nmr-data

# Optional isolated DP5q 13C mean-model shadow evaluation. Keep off unless
# setup_dp5q_sidecar.ps1 has verified the pinned repository and model hashes.
CHEMAPP_DP5Q_MODE=off
# CHEMAPP_DP5Q_PYTHON=C:/Users/you/AppData/Local/ChemApp/dp5q/.venv/Scripts/python.exe
# CHEMAPP_DP5Q_REPO=C:/Users/you/AppData/Local/ChemApp/dp5q/DP5
CHEMAPP_DP5Q_TIMEOUT_SECONDS=20
CHEMAPP_DP5Q_STARTUP_TIMEOUT_SECONDS=45
CHEMAPP_DP5Q_BUSY_TIMEOUT_SECONDS=0.1
CHEMAPP_DP5Q_MAX_CANDIDATES=5
# Optional pinned 99-quantile sidecar. Its assigned-score equations match the
# fixed upstream source, but the ChemApp conformer workflow is not official.
# The endpoint is an admin-only unassigned shadow and never changes ranking.
CHEMAPP_DP5Q_QUANTILE_MODE=off
CHEMAPP_DP5Q_QUANTILE_BUSY_TIMEOUT_SECONDS=0.1
CHEMAPP_DP5Q_QUANTILE_MAX_CANDIDATES=3

# Browser origins, comma-separated
CHEMAPP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional Host-header allowlist for a deployed API, for example:
# CHEMAPP_TRUSTED_HOSTS=chemapp.example.org,localhost

# Required for destructive, model-import, and training operations outside
# loopback.  Use a long random value and send it as X-ChemApp-Admin-Token.
CHEMAPP_ACCESS_TOKEN=replace-with-a-separate-access-secret
CHEMAPP_ADMIN_TOKEN=replace-with-a-long-random-secret
# HMAC key shared by every backend worker for short-lived destructive-action
# preview tokens. Use a separate long random value in production. If omitted,
# the backend derives it from the access/admin token; rotating that token then
# invalidates previews that are still open. The process-random fallback is only
# suitable for single-process local development and tests.
CHEMAPP_AI_PREVIEW_SECRET=replace-with-another-long-random-secret
CHEMAPP_AI_PREVIEW_TTL_SECONDS=300
# Stable pseudonymous subject recorded for review-queue administration and
# adjudication. It must not equal any CHEMAPP_REVIEWER_TOKENS key.
CHEMAPP_REVIEW_ADMIN_SUBJECT=curation-admin
# JSON mapping of stable reviewer subjects to distinct high-entropy secrets.
# Review writes fail closed when this is absent or invalid. Never reuse access
# or administrator credentials, and never commit real reviewer tokens.
CHEMAPP_REVIEWER_TOKENS={"reviewer-a":"replace-with-reviewer-a-secret","reviewer-b":"replace-with-reviewer-b-secret"}
# Comma-separated SPDX identifiers accepted into the Gold review workflow.
CHEMAPP_REVIEW_ALLOWED_LICENSES=CC0-1.0,CC-BY-4.0,CC-BY-SA-4.0
CHEMAPP_LOCAL_ACCESS_BYPASS=1
CHEMAPP_LOCAL_ADMIN_BYPASS=1
CHEMAPP_PROTECT_READY=0

# CSP5 生产前向评分器：on=严格启用（权重缺失/哈希不匹配则拒绝启动），
# auto=有权重则用、否则告警回退本地 GNN，off=禁用。生产容器请保持 on。
CHEMAPP_CSP5_MODE=auto

# Upload and archive limits
CHEMAPP_MAX_UPLOAD_BYTES=52428800
CHEMAPP_MAX_ZIP_FILES=2000
CHEMAPP_MAX_ZIP_UNCOMPRESSED_BYTES=536870912
CHEMAPP_MAX_ZIP_COMPRESSION_RATIO=200
CHEMAPP_MAX_ZIP_MEMBER_NAME=512
CHEMAPP_HPLC_MAX_XML_BYTES=20971520
CHEMAPP_HPLC_MAX_TRACE_BYTES=134217728
CHEMAPP_MAX_HANDOUT_BYTES=26214400
CHEMAPP_MAX_DOCX_FILES=500
CHEMAPP_MAX_DOCX_UNCOMPRESSED_BYTES=104857600
CHEMAPP_MAX_DOCX_XML_BYTES=20971520

# Server-managed LLM configuration (optional)
# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro
CHEMAPP_LLM_ALLOWED_HOSTS=api.deepseek.com,api.openai.com
CHEMAPP_LLM_MAX_TOKENS=32768

# Keep disabled unless an explicitly trusted on-prem provider requires them.
CHEMAPP_ALLOW_PRIVATE_LLM_BASE_URL=0
CHEMAPP_ALLOW_INSECURE_LLM_BASE_URL=0
